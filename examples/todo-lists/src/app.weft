module todo_lists

# ── Client: components with local state, changed by actions ───
#
# A sidebar of lists and a panel for the selected list. Each piece keeps the
# state only it needs: the sidebar its new-list form, each row its own inline
# editing. Views read all_lists(), find_list() and items_in() as if the data
# were local; the compiler adds the syncing (language.md, section 7).

client App {
  state selected: [None, Some(Id)] = None

  view = main {
    Sidebar(selected: selected, on_select: select)
    match selected {
      None     -> p { "Pick a list, or make one" }
      Some(id) -> match find_list(id) {
        Missing     -> p { "This list was deleted on another device" }
        Found(list) -> ListPanel(list: list, on_deleted: deselect)
      }
    }
  }

  action select(id: Id) { selected = Some(id) }
  action deselect       { selected = None }
}

component Sidebar(selected: [None, Some(Id)], on_select: Id -> action) {
  state name    = ""
  state problem = None

  view = nav {
    ul {
      for row in all_lists() key row.list.id {
        li(on_click: on_select(row.list.id), current: selected == Some(row.list.id)) {
          span { row.list.name }
          span(class: "count") { "${row.open}" }
        }
      }
    }
    form(on_submit: create) {
      input(bind: name, placeholder: "New list")
    }
    match problem {
      None      -> nothing
      EmptyName -> p(class: "error") { "A list needs a name" }
    }
  }

  action create {
    problem = None
    do create_list!(name) else |err| problem = err
    name = ""
  }
}

component ListPanel(list: TodoList, on_deleted: action) {
  state show     = All
  state draft    = ""
  state renaming = False
  state new_name = ""
  state problem  = None

  view = section {
    header {
      if renaming {
        form(on_submit: rename) {
          input(bind: new_name)
          button(on_click: stop_renaming) { "Cancel" }
        }
      } else {
        h2(on_click: start_renaming) { list.name }
      }
    }

    form(on_submit: add) {
      input(bind: draft, placeholder: "Add an item")
    }
    match problem {
      None       -> nothing
      EmptyName  -> p(class: "error") { "A list needs a name" }
      EmptyTitle -> p(class: "error") { "An item needs a title" }
      NoSuchList -> p(class: "error") { "That list was deleted" }
    }

    ul {
      for i in items_in(list.id, show) key i.id { ItemRow(item: i) }
    }

    footer {
      for f in [All, Active, Done] {
        button(on_click: filter(f), pressed: show == f) { f.to_str() }
      }
      button(on_click: clear) { "Clear done" }
      button(on_click: delete) { "Delete list" }
    }
  }

  action start_renaming {
    renaming = True
    new_name = list.name
  }

  action stop_renaming { renaming = False }

  action rename {
    renaming = False
    do rename_list!(list.id, new_name) else |err| problem = err
  }

  action add {
    problem = None
    do add_item!(list.id, draft) else |err| problem = err
    draft = ""
  }

  action filter(f: Filter) { show = f }
  action clear             { do clear_done!(list.id) }

  action delete {
    do delete_list!(list.id)
    do on_deleted()
  }
}

component ItemRow(item: Item) {
  state editing = False
  state draft   = ""
  state problem = None

  view = li {
    # The click carries the value the person wants, not "flip it".
    checkbox(checked: item.done, on_change: done(not item.done))
    if editing {
      form(on_submit: save) {
        input(bind: draft)
        button(on_click: cancel) { "Cancel" }
      }
    } else {
      span(class: if item.done "done" else "", on_click: edit) { item.title }
    }
    match problem {
      None       -> nothing
      EmptyTitle -> p(class: "error") { "An item needs a title" }
    }
    button(on_click: remove) { "Delete" }
  }

  action edit {
    editing = True
    draft = item.title
  }

  action cancel { editing = False }

  action save {
    editing = False
    do rename_item!(item.id, draft) else |err| problem = err
  }

  action done(d: Bool) { do set_done!(item.id, d) }
  action remove        { do delete_item!(item.id) }
}
