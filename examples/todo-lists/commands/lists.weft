# Every write to `lists`.
#
# Commands are written as if the app ran on one machine. Nothing here mentions
# the network, retries, locks or duplicate requests: the compiler adds those
# where the logic needs them (README, "What to look at").

create_list! : Text => Id(TodoList) ! <reject [EmptyName], ..>
create_list! = |name| {
  cleaned = name.trim()
  if cleaned.is_empty() { reject EmptyName }
  lists.insert!(TodoList { name: cleaned })
}

rename_list! : Id(TodoList), Text => {} ! <reject [EmptyName], ..>
rename_list! = |id, name| {
  cleaned = name.trim()
  if cleaned.is_empty() { reject EmptyName }
  lists.update!(id, |l| { ..l, name: cleaned })
}

## The list's items go with it: see `delete_with` in data/item.weft.
delete_list! : Id(TodoList) => {} ! <..>
delete_list! = |id| lists.delete!(id)
