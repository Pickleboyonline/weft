{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Weft",
  "scopeName": "source.weft",
  "fileTypes": ["weft"],
  "comment": "Follows the language reference in website/docs/reference/. Keep website/src/theme/prism-weft.ts in step.",
  "patterns": [{ "include": "#main" }],
  "repository": {
    "main": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#style-block" },
        { "include": "#declarations" },
        { "include": "#line-starts" },
        { "include": "#lambda" },
        { "include": "#numbers" },
        { "include": "#labels" },
        { "include": "#keywords" },
        { "include": "#markup" },
        { "include": "#calls" },
        { "include": "#types" },
        { "include": "#operators" },
        { "include": "#punctuation" },
        { "include": "#identifiers" }
      ]
    },

    "comments": {
      "patterns": [
        {
          "comment": "//! documents the file; /// documents the declaration below",
          "name": "comment.line.documentation.weft",
          "match": "(//[!/]).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.weft" } }
        },
        {
          "name": "comment.line.double-slash.weft",
          "match": "(//).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.weft" } }
        },
        { "include": "#block-comment" }
      ]
    },

    "block-comment": {
      "comment": "/* ... */ nests, so it includes itself",
      "name": "comment.block.weft",
      "begin": "/\\*",
      "end": "\\*/",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.weft" } },
      "endCaptures": { "0": { "name": "punctuation.definition.comment.end.weft" } },
      "patterns": [{ "include": "#block-comment" }]
    },

    "strings": {
      "patterns": [
        {
          "comment": "\"\"\" multi-line text \"\"\"",
          "name": "string.quoted.triple.weft",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.weft" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.weft" } },
          "patterns": [{ "include": "#string-contents" }]
        },
        {
          "name": "string.quoted.double.weft",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.weft" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.weft" } },
          "patterns": [{ "include": "#string-contents" }]
        }
      ]
    },

    "string-contents": {
      "patterns": [
        { "name": "constant.character.escape.weft", "match": "\\\\(u\\{[0-9A-Fa-f]+\\}|.)" },
        {
          "name": "meta.template.expression.weft",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.weft" } },
          "endCaptures": { "0": { "name": "punctuation.definition.template-expression.end.weft" } },
          "contentName": "meta.embedded.line.weft",
          "patterns": [{ "include": "#main" }]
        }
      ]
    },

    "style-block": {
      "comment": "A component's scoped CSS. It ends at a } indented like `style`, so CSS rules inside can use braces.",
      "begin": "^(\\s*)(style)\\s*(\\{)\\s*$",
      "end": "^\\1(\\})",
      "beginCaptures": {
        "2": { "name": "storage.type.style.weft" },
        "3": { "name": "punctuation.section.block.begin.weft" }
      },
      "endCaptures": { "1": { "name": "punctuation.section.block.end.weft" } },
      "contentName": "meta.embedded.block.css",
      "patterns": [{ "include": "source.css" }]
    },

    "declarations": {
      "patterns": [
        {
          "match": "\\b(record)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.record.weft" },
            "2": { "name": "entity.name.type.weft" }
          }
        },
        {
          "match": "\\b(component)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.component.weft" },
            "2": { "name": "entity.name.type.class.weft" }
          }
        },
        {
          "match": "\\b(effect)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.effect.weft" },
            "2": { "name": "entity.name.type.weft" }
          }
        },
        {
          "comment": "handler audit_to_table : Audit {",
          "match": "\\b(handler)\\s+([a-z_][A-Za-z0-9_]*)\\s*(:)\\s*([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.handler.weft" },
            "2": { "name": "entity.name.function.weft" },
            "3": { "name": "punctuation.separator.type.weft" },
            "4": { "name": "entity.name.type.weft" }
          }
        },
        {
          "comment": "state draft = \"\"   let cleaned = …   let mut count = 0",
          "match": "\\b(state|let)(?:\\s+(mut))?\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.$1.weft" },
            "2": { "name": "storage.modifier.mut.weft" },
            "3": { "name": "variable.other.definition.weft" }
          }
        },
        {
          "comment": "let before a pattern: let { title, done } = item",
          "match": "\\b(let)\\b(?:\\s+(mut)\\b)?",
          "captures": {
            "1": { "name": "storage.type.let.weft" },
            "2": { "name": "storage.modifier.mut.weft" }
          }
        },
        {
          "comment": "Operation kinds inside an effect: final abort : …",
          "match": "^\\s*(final|ctl)\\s+(?=[a-z_][A-Za-z0-9_]*\\s*:)",
          "captures": { "1": { "name": "storage.modifier.$1.weft" } }
        }
      ]
    },

    "line-starts": {
      "comment": "Things recognized by how a line begins.",
      "patterns": [
        {
          "comment": "Filter : [All, Active, Done]",
          "match": "^\\s*([A-Z][A-Za-z0-9_]*)\\s*(:)(?!:)",
          "captures": {
            "1": { "name": "entity.name.type.weft" },
            "2": { "name": "punctuation.separator.type.weft" }
          }
        },
        {
          "comment": "add_item : Id(TodoList), Text -> … A space before the colon separates signatures from record fields.",
          "match": "^\\s*((?:[A-Z][A-Za-z0-9_]*\\.)?[a-z_][A-Za-z0-9_]*)\\s+(:)\\s",
          "captures": {
            "1": { "name": "entity.name.function.weft" },
            "2": { "name": "punctuation.separator.type.weft" }
          }
        },
        {
          "comment": "Work tied to a component's life: task { … }  task(key: symbol) { … }",
          "match": "^\\s*(task)\\b(?=\\s*[({])",
          "captures": { "1": { "name": "storage.type.task.weft" } }
        },
        {
          "comment": "A component's markup: view = li { … }",
          "match": "^\\s*(view)\\s*(=)(?![=>])",
          "captures": {
            "1": { "name": "storage.type.view.weft" },
            "2": { "name": "keyword.operator.assignment.weft" }
          }
        },
        {
          "comment": "A function definition: keeps = |show, i| …",
          "match": "^\\s*([a-z_][A-Za-z0-9_]*)\\s*(=)(?![=>])(?=\\s*\\|)",
          "captures": {
            "1": { "name": "entity.name.function.weft" },
            "2": { "name": "keyword.operator.assignment.weft" }
          }
        },
        {
          "comment": "Any other binding or assignment: items = Table(Item), cleaned = title.trim()",
          "match": "^\\s*([a-z_][A-Za-z0-9_]*)\\s*(=)(?![=>])",
          "captures": {
            "1": { "name": "variable.other.definition.weft" },
            "2": { "name": "keyword.operator.assignment.weft" }
          }
        },
        {
          "comment": "key id: Id(Item)",
          "match": "^\\s*(key)\\s+(?=[a-z_][A-Za-z0-9_]*\\s*:)",
          "captures": { "1": { "name": "storage.modifier.key.weft" } }
        }
      ]
    },

    "lambda": {
      "comment": "|m, msg| and || (no parameters)",
      "name": "meta.parameters.lambda.weft",
      "begin": "\\|(?=[^|\\n]*\\|)",
      "end": "\\|",
      "beginCaptures": { "0": { "name": "punctuation.definition.parameters.begin.weft" } },
      "endCaptures": { "0": { "name": "punctuation.definition.parameters.end.weft" } },
      "patterns": [
        { "name": "variable.parameter.weft", "match": "\\b[a-z_][A-Za-z0-9_]*\\b" },
        { "include": "#punctuation" }
      ]
    },

    "numbers": {
      "comment": "42  1_000  3.14  0.5f  5ms  30min  64MB  10%",
      "match": "\\b[0-9][0-9_]*(?:\\.[0-9]+)?(?:(ns|us|ms|s|min|h|d|w|B|KB|MB|GB|TB|f)\\b|(%))?",
      "name": "constant.numeric.weft",
      "captures": {
        "1": { "name": "keyword.other.unit.weft" },
        "2": { "name": "keyword.other.unit.weft" }
      }
    },

    "labels": {
      "comment": "Record fields and named arguments: { draft: Text }, on_click: save",
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(:)(?!:)",
      "captures": {
        "1": { "name": "variable.other.property.weft" },
        "2": { "name": "punctuation.separator.key-value.weft" }
      }
    },

    "keywords": {
      "patterns": [
        { "name": "keyword.control.weft", "match": "\\b(if|else|match|for|in|while|break|continue|return|await|defer|crash|with)\\b" },
        { "name": "keyword.other.weft", "match": "\\b(where|expect)\\b" },
        { "name": "keyword.operator.wordlike.logical.weft", "match": "\\b(and|or|not)\\b" },
        { "name": "constant.language.boolean.weft", "match": "\\b(True|False)\\b" },
        { "name": "constant.language.weft", "match": "\\b(nothing|outlet)\\b" }
      ]
    },

    "markup": {
      "comment": "UI elements: li { … }, button(on_click: …) { … }",
      "match": "\\b(main|nav|section|header|footer|article|aside|div|form|input|textarea|select|option|label|button|checkbox|ul|ol|li|span|p|a|link|img|h[1-6]|strong|em|code|pre|br|hr)\\b(?=\\s*[({])",
      "name": "entity.name.tag.weft"
    },

    "calls": {
      "patterns": [
        {
          "comment": "Method call: .insert(…)  .trim()",
          "match": "(\\.)([a-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.weft" },
            "2": { "name": "entity.name.function.member.weft" }
          }
        },
        {
          "comment": "Waiting: create_list(name).await",
          "match": "(\\.)(await)\\b",
          "captures": {
            "1": { "name": "punctuation.accessor.weft" },
            "2": { "name": "keyword.control.weft" }
          }
        },
        {
          "comment": "Field access and accessor shorthand: m.draft  .created",
          "match": "(\\.)([a-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "punctuation.accessor.weft" },
            "2": { "name": "variable.other.property.weft" }
          }
        },
        {
          "comment": "Call: keeps(show, t)  add_item(list, title)",
          "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.weft" }
          }
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "comment": "Built-in types and standard-library configuration types",
          "name": "support.type.builtin.weft",
          "match": "\\b(Int|Dec|Float|Bool|Text|Bytes|Time|Date|Duration|Size|Id|List|Dict|Set|Range|Option|Result|Table|Query|Command|Check|Pending|Element|Secret|Action|Html|Route|Deployment|Machine|Simulation|Network|Crashes|Extern|Job|Endpoint|Request|Response|Fallible|Constant|Script)\\b"
        },
        {
          "comment": "User types and tags: Todo, Filter, All, Some(id), EmptyTitle",
          "name": "entity.name.type.weft",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.weft", "match": "->" },
        { "name": "keyword.operator.range.weft", "match": "\\.\\.[<=]" },
        { "name": "keyword.operator.spread.weft", "match": "\\.\\." },
        { "name": "keyword.operator.comparison.weft", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.assignment.weft", "match": "=" },
        { "name": "keyword.operator.arithmetic.weft", "match": "[+\\-*/%]" },
        { "name": "keyword.operator.try.weft", "match": "\\?" }
      ]
    },

    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.comma.weft", "match": "," },
        { "name": "punctuation.separator.colon.weft", "match": ":" },
        { "name": "punctuation.section.braces.weft", "match": "[{}]" },
        { "name": "punctuation.section.brackets.weft", "match": "[\\[\\]]" },
        { "name": "punctuation.section.parens.weft", "match": "[()]" }
      ]
    },

    "identifiers": {
      "patterns": [
        { "name": "variable.language.wildcard.weft", "match": "\\b_\\b" },
        { "name": "variable.other.readwrite.weft", "match": "\\b[a-z_][A-Za-z0-9_]*\\b" }
      ]
    }
  }
}
