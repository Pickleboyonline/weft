module todo_lists

# ── Data ──────────────────────────────────────────────────────
#
# Two tables: lists, and the items in them. There are no users yet,
# so everyone shares the same lists (see README, "Gaps").

record TodoList {
  key id:  Id   = new_id!()
  name:    Text
  created: Time = now!()
}

record Item {
  key id:  Id   = new_id!()
  list:    Id                 # the TodoList this item belongs to
  title:   Text
  done:    Bool = False
  created: Time = now!()
}

Filter : [All, Active, Done]

table lists : TodoList
table items : Item
