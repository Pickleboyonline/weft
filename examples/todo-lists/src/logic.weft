module todo_lists

# ── Commands: every write goes through one of these ───────────
#
# Written as if the app ran on one machine. Nothing here mentions
# the network, retries, locks or duplicate requests: the compiler
# adds those where the logic needs them (README, "What to look at").

# Lists

command create_list!(name: Text) {
  cleaned = name.trim()
  if cleaned.is_empty() { reject EmptyName }
  lists.insert!(TodoList { name: cleaned })
}

command rename_list!(id: Id, name: Text) {
  cleaned = name.trim()
  if cleaned.is_empty() { reject EmptyName }
  lists.update!(id, |l| { ..l, name: cleaned })
}

command delete_list!(id: Id) {
  items.delete!(|i| i.list == id)        # a list's items go with it
  lists.delete!(|l| l.id == id)
}

# Items

command add_item!(list: Id, title: Text) {
  cleaned = title.trim()
  if cleaned.is_empty() { reject EmptyTitle }
  if not lists.has(list) { reject NoSuchList }    # it may have been deleted on another device
  items.insert!(Item { list: list, title: cleaned })
}

command rename_item!(id: Id, title: Text) {
  cleaned = title.trim()
  if cleaned.is_empty() { reject EmptyTitle }
  items.update!(id, |i| { ..i, title: cleaned })
}

# set_done!, not toggle!. A checkbox click means "make it done" (or
# "make it not done"), so the command says that. If two devices both
# tick the box, the item ends up done, which is what both people meant.
# A toggle! would flip it twice and leave it not done.
command set_done!(id: Id, done: Bool) {
  items.update!(id, |i| { ..i, done: done })
}

command delete_item!(id: Id) {
  items.delete!(|i| i.id == id)
}

command clear_done!(list: Id) {
  items.delete!(|i| i.list == list and i.done)
}

# ── Views: read-only queries the client can use ───────────────

keeps = |show, i| match show {
  All    -> True
  Active -> not i.done
  Done   -> i.done
}

# Every list with its number of open items, oldest first.
view all_lists() -> List({ list: TodoList, open: U64 }) =
  lists
    .sort_by(.created)
    .map(|l| { list: l, open: items.count(|i| i.list == l.id and not i.done) })

view find_list(id: Id) -> [Missing, Found(TodoList)] =
  lists.get(id)

view items_in(list: Id, show: Filter) -> List(Item) =
  items
    .filter(|i| i.list == list and keeps(show, i))
    .sort_by(.created)
