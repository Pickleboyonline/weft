/// A server with Postgres, and any number of browsers.
///
/// Nothing outside deploy/ and simulate/ changes between deployments. `local`
/// (the one-process reference every run is checked against) is generated.
prod = Deployment {
  machines: {
    server:  Machine { platform: "weft/server-rust-postgres" },
    browser: Machine { platform: "weft/browser-ts", count: Many },
  },
}
