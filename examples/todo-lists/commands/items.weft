// Every write to `items`. Each Command is a remote function the client calls.

add_item = Command(|list: Id(TodoList), title: Text| -> Result(Id(Item), [EmptyTitle, NoSuchList]) {
  let cleaned = title.trim()
  if cleaned.is_empty() { return Err(EmptyTitle) }
  if not lists.has(list) { return Err(NoSuchList) }  // it may have been deleted on another device
  Ok(items.insert(Item { list, title: cleaned }))
})

rename_item = Command(|id: Id(Item), title: Text| -> Result({}, [EmptyTitle]) {
  let cleaned = title.trim()
  if cleaned.is_empty() { return Err(EmptyTitle) }
  Ok(items.update(id, |i| { ..i, title: cleaned }))
})

/// set_done, not toggle. A checkbox click means "make it done" (or
/// "make it not done"), so the command says that. If two devices both
/// tick the box, the item ends up done, which is what both people meant.
/// A toggle would flip it twice and leave it not done.
set_done = Command(|id: Id(Item), done: Bool| -> {} {
  items.update(id, |i| { ..i, done })
})

delete_item = Command(|id: Id(Item)| -> {} { items.delete(id) })

clear_done = Command(|list: Id(TodoList)| -> {} {
  items.delete_where(|i| i.list == list and i.done)
})
