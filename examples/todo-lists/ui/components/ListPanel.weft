# One list: its name (click to rename), a form to add items, the items, and
# filters.

component ListPanel(list: TodoList) {
  state show     = All
  state draft    = ""
  state renaming = False
  state new_name = ""
  state problem  = None

  view = section {
    header {
      if renaming {
        form(on_submit: rename) {
          input(bind: new_name)
          button(on_click: stop_renaming) { "Cancel" }
        }
      } else {
        h2(on_click: start_renaming) { list.name }
      }
    }

    form(on_submit: add) {
      input(bind: draft, placeholder: "Add an item")
    }
    match problem {
      None       -> nothing
      EmptyName  -> p(class: "error") { "A list needs a name" }
      EmptyTitle -> p(class: "error") { "An item needs a title" }
      NoSuchList -> p(class: "error") { "That list was deleted" }
    }

    ul {
      for i in items_in(list.id, show) key i.id { ItemRow(item: i) }
    }

    footer {
      for f in [All, Active, Done] {
        button(on_click: filter(f), pressed: show == f) { f.to_str() }
      }
      button(on_click: clear) { "Clear done" }
      button(on_click: delete) { "Delete list" }
    }
  }

  action start_renaming {
    renaming = True
    new_name = list.name
  }

  action stop_renaming { renaming = False }

  action rename {
    renaming = False
    do rename_list!(list.id, new_name) else |err| problem = err
  }

  action add {
    problem = None
    do add_item!(list.id, draft) else |err| problem = err
    draft = ""
  }

  action filter(f: Filter) { show = f }
  action clear             { do clear_done!(list.id) }

  action delete {
    do delete_list!(list.id)
    do go(Home)
  }
}
