{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "comment": "Highlights ```weft fenced code blocks inside Markdown files (in the editor, not the preview).",
  "scopeName": "markdown.weft.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [{ "include": "#weft-code-block" }],
  "repository": {
    "weft-code-block": {
      "name": "markup.fenced_code.block.markdown",
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(weft)((\\s+|:|,|\\{|\\?)[^`]*)?$)",
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" },
        "4": { "name": "fenced_code.block.language.markdown" },
        "5": { "name": "fenced_code.block.language.attributes.markdown" }
      },
      "endCaptures": {
        "3": { "name": "punctuation.definition.markdown" }
      },
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
          "contentName": "meta.embedded.block.weft",
          "patterns": [{ "include": "source.weft" }]
        }
      ]
    }
  }
}
