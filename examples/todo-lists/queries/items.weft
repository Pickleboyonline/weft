# Reads of `items` that the client uses.

keeps = |show, i| match show {
  All    -> True
  Active -> not i.done
  Done   -> i.done
}

expect keeps(Active, { done: True }) == False
expect keeps(Done, { done: True })

items_in = |list, show| items
  .filter(|i| i.list == list and keeps(show, i))
  .sort_by(.created)
