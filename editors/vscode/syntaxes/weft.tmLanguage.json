{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Weft",
  "scopeName": "source.weft",
  "fileTypes": ["weft"],
  "patterns": [{ "include": "#main" }],
  "repository": {
    "main": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#deploy-blocks" },
        { "include": "#sim-block" },
        { "include": "#declarations" },
        { "include": "#line-starts" },
        { "include": "#effect-row" },
        { "include": "#lambda" },
        { "include": "#numbers" },
        { "include": "#labels" },
        { "include": "#keywords" },
        { "include": "#markup" },
        { "include": "#calls" },
        { "include": "#types" },
        { "include": "#operators" },
        { "include": "#punctuation" },
        { "include": "#identifiers" }
      ]
    },

    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.weft",
          "match": "(#).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.weft" } }
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.weft",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.weft" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.weft" } },
          "patterns": [
            { "name": "constant.character.escape.weft", "match": "\\\\." },
            {
              "name": "meta.template.expression.weft",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.weft" } },
              "endCaptures": { "0": { "name": "punctuation.definition.template-expression.end.weft" } },
              "contentName": "meta.embedded.line.weft",
              "patterns": [{ "include": "#main" }]
            }
          ]
        }
      ]
    },

    "deploy-blocks": {
      "comment": "deploy/simulate blocks. Their vocabulary (consistency, budget, pin, ...) is only highlighted inside them.",
      "name": "meta.block.deploy.weft",
      "begin": "\\b(deploy|simulate)\\s+([a-z_][A-Za-z0-9_]*)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "storage.type.deploy.weft" },
        "2": { "name": "entity.name.namespace.weft" },
        "3": { "name": "punctuation.section.block.begin.weft" }
      },
      "endCaptures": { "0": { "name": "punctuation.section.block.end.weft" } },
      "patterns": [{ "include": "#deploy-body" }]
    },

    "deploy-body": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        {
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.braces.begin.weft" } },
          "endCaptures": { "0": { "name": "punctuation.section.braces.end.weft" } },
          "patterns": [{ "include": "#deploy-body" }]
        },
        {
          "match": "\\b(machine)\\s+([a-z_][A-Za-z0-9_]*)\\s+(on)\\b",
          "captures": {
            "1": { "name": "keyword.other.deploy.weft" },
            "2": { "name": "entity.name.variable.machine.weft" },
            "3": { "name": "keyword.other.deploy.weft" }
          }
        },
        {
          "name": "keyword.other.deploy.weft",
          "match": "\\b(place|on|consistency|durability|budget|pin|sync|to)\\b"
        },
        {
          "name": "constant.language.deploy.weft",
          "match": "\\b(everything|many|session|strong|eventual|serializable|linearizable|committed|durable|replicated?|materialized|random|msgs|per|client|clients|drop|latency|offline|max|p[0-9]+)\\b"
        },
        { "include": "#main" }
      ]
    },

    "sim-block": {
      "comment": "An extern's simulation model: sim { ok 95%, else Bounced, latency 50ms..2s }",
      "name": "meta.block.sim.weft",
      "begin": "\\b(sim)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "storage.type.sim.weft" },
        "2": { "name": "punctuation.section.block.begin.weft" }
      },
      "endCaptures": { "0": { "name": "punctuation.section.block.end.weft" } },
      "patterns": [
        { "name": "constant.language.deploy.weft", "match": "\\b(ok|latency|drop|offline)\\b" },
        { "include": "#main" }
      ]
    },

    "declarations": {
      "patterns": [
        {
          "match": "\\b(module|import)\\s+([A-Za-z_][A-Za-z0-9_./]*)",
          "captures": {
            "1": { "name": "keyword.other.module.weft" },
            "2": { "name": "entity.name.namespace.weft" }
          }
        },
        {
          "match": "\\b(record)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.record.weft" },
            "2": { "name": "entity.name.type.weft" }
          }
        },
        {
          "match": "\\b(table)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.table.weft" },
            "2": { "name": "entity.name.variable.table.weft" }
          }
        },
        {
          "match": "\\b(command|extern)\\s+([a-z_][A-Za-z0-9_]*)(!)?",
          "captures": {
            "1": { "name": "storage.type.$1.weft" },
            "2": { "name": "entity.name.function.weft" },
            "3": { "name": "keyword.other.effect.weft" }
          }
        },
        {
          "match": "\\b(view|check)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.$1.weft" },
            "2": { "name": "entity.name.function.weft" }
          }
        },
        {
          "match": "\\b(client|component)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.$1.weft" },
            "2": { "name": "entity.name.type.class.weft" }
          }
        },
        {
          "comment": "action save { ... }   action done(d: Bool) { ... }",
          "match": "\\b(action)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.action.weft" },
            "2": { "name": "entity.name.function.weft" }
          }
        },
        {
          "comment": "state draft = \"\"",
          "match": "\\b(state)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.state.weft" },
            "2": { "name": "variable.other.definition.weft" }
          }
        },
        {
          "match": "\\b(effect)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.effect.weft" },
            "2": { "name": "entity.name.type.weft" }
          }
        },
        {
          "match": "\\b(handler)\\s+([a-z_][A-Za-z0-9_]*)\\s+(for)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.handler.weft" },
            "2": { "name": "entity.name.function.weft" },
            "3": { "name": "keyword.other.for.weft" },
            "4": { "name": "entity.name.type.weft" }
          }
        },
        {
          "match": "\\b(?:(final)\\s+)?(fun|ctl)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.final.weft" },
            "2": { "name": "storage.type.function.weft" },
            "3": { "name": "entity.name.function.weft" }
          }
        },
        {
          "match": "\\b(needs)\\s+([a-z_][A-Za-z0-9_]*(?:\\s*,\\s*[a-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": { "name": "keyword.other.needs.weft" },
            "2": { "name": "constant.language.capability.weft" }
          }
        }
      ]
    },

    "line-starts": {
      "comment": "Things recognized by how a line begins: type declarations, type signatures, definitions, key fields.",
      "patterns": [
        {
          "comment": "Model : { ... }   Filter : [All, Active, Done]",
          "match": "^\\s*([A-Z][A-Za-z0-9_]*)\\s*(:)(?!:)",
          "captures": {
            "1": { "name": "entity.name.type.weft" },
            "2": { "name": "punctuation.separator.type.weft" }
          }
        },
        {
          "comment": "add_todo! : Text => {}   App.view : Model -> Html(Msg). A space before the colon separates these from record fields.",
          "match": "^\\s*((?:[A-Z][A-Za-z0-9_]*\\.)?[a-z_][A-Za-z0-9_]*)(!)?\\s+(:)\\s",
          "captures": {
            "1": { "name": "entity.name.function.weft" },
            "2": { "name": "keyword.other.effect.weft" },
            "3": { "name": "punctuation.separator.type.weft" }
          }
        },
        {
          "comment": "A component's markup: view = li { ... }",
          "match": "^\\s*(view)\\s*(=)(?![=>])",
          "captures": {
            "1": { "name": "storage.type.view.weft" },
            "2": { "name": "keyword.operator.assignment.weft" }
          }
        },
        {
          "comment": "update = |m, msg| ...",
          "match": "^\\s*([a-z_][A-Za-z0-9_]*)(!)?\\s*(=)(?![=>])(?=\\s*\\|)",
          "captures": {
            "1": { "name": "entity.name.function.weft" },
            "2": { "name": "keyword.other.effect.weft" },
            "3": { "name": "keyword.operator.assignment.weft" }
          }
        },
        {
          "comment": "cleaned = name.trim()   init = { ... }",
          "match": "^\\s*([a-z_][A-Za-z0-9_]*)\\s*(=)(?![=>])",
          "captures": {
            "1": { "name": "variable.other.definition.weft" },
            "2": { "name": "keyword.operator.assignment.weft" }
          }
        },
        {
          "comment": "key id: Id",
          "match": "^\\s*(key)\\s+(?=[a-z_][A-Za-z0-9_]*\\s*:)",
          "captures": { "1": { "name": "storage.modifier.key.weft" } }
        }
      ]
    },

    "effect-row": {
      "comment": "! <write todos, reject [EmptyTitle]>",
      "name": "meta.effects.weft",
      "begin": "(!)\\s*(<)",
      "end": ">",
      "beginCaptures": {
        "1": { "name": "keyword.other.effect.weft" },
        "2": { "name": "punctuation.definition.effects.begin.weft" }
      },
      "endCaptures": { "0": { "name": "punctuation.definition.effects.end.weft" } },
      "patterns": [
        { "name": "keyword.other.effect.kind.weft", "match": "\\b(read|write|reject|random|time)\\b" },
        { "include": "#main" }
      ]
    },

    "lambda": {
      "comment": "|m, msg| and || (no parameters)",
      "name": "meta.parameters.lambda.weft",
      "begin": "\\|(?=[^|\\n]*\\|)",
      "end": "\\|",
      "beginCaptures": { "0": { "name": "punctuation.definition.parameters.begin.weft" } },
      "endCaptures": { "0": { "name": "punctuation.definition.parameters.end.weft" } },
      "patterns": [
        { "name": "variable.parameter.weft", "match": "\\b[a-z_][A-Za-z0-9_]*\\b" },
        { "include": "#punctuation" }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "comment": "$50/month",
          "match": "(\\$)[0-9][0-9_]*(?:\\.[0-9]+)?(?:(/)(month|week|day|hour|year))?",
          "name": "constant.numeric.money.weft",
          "captures": {
            "3": { "name": "keyword.other.unit.weft" }
          }
        },
        {
          "comment": "42  3.5  5ms  2s  10%  64MB",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9]+)?(?:(ns|us|ms|s|m|h|d|KB|MB|GB|TB)\\b|(%))?",
          "name": "constant.numeric.weft",
          "captures": {
            "1": { "name": "keyword.other.unit.weft" },
            "2": { "name": "keyword.other.unit.weft" }
          }
        }
      ]
    },

    "labels": {
      "comment": "Record fields and named arguments: { draft: Text }, on_click: Select(id)",
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(:)(?!:)",
      "captures": {
        "1": { "name": "variable.other.property.weft" },
        "2": { "name": "punctuation.separator.key-value.weft" }
      }
    },

    "keywords": {
      "patterns": [
        { "name": "keyword.control.weft", "match": "\\b(if|else|match|for|in|key|do|reject)\\b" },
        { "name": "keyword.operator.wordlike.logical.weft", "match": "\\b(and|or|not)\\b" },
        { "name": "constant.language.boolean.weft", "match": "\\b(True|False)\\b" },
        { "name": "constant.language.weft", "match": "\\b(none|nothing)\\b" }
      ]
    },

    "markup": {
      "comment": "UI elements in a client view: li { ... }, button(on_click: ...) { ... }",
      "match": "\\b(main|nav|section|header|footer|article|aside|div|form|input|textarea|select|option|label|button|checkbox|ul|ol|li|span|p|a|img|h[1-6]|strong|em|code|pre|br|hr)\\b(?=\\s*[({])",
      "name": "entity.name.tag.weft"
    },

    "calls": {
      "patterns": [
        {
          "comment": "Method call: .insert!(...)  .trim()",
          "match": "(\\.)([a-z_][A-Za-z0-9_]*)(!)?(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.weft" },
            "2": { "name": "entity.name.function.member.weft" },
            "3": { "name": "keyword.other.effect.weft" }
          }
        },
        {
          "comment": "Field access and accessor shorthand: m.draft  .created",
          "match": "(\\.)([a-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "punctuation.accessor.weft" },
            "2": { "name": "variable.other.property.weft" }
          }
        },
        {
          "comment": "Call: keeps(show, t)  add_todo!(title)",
          "match": "\\b([a-z_][A-Za-z0-9_]*)(!)?(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.weft" },
            "2": { "name": "keyword.other.effect.weft" }
          }
        },
        {
          "comment": "An effectful name that isn't being called here: main!",
          "match": "\\b([a-z_][A-Za-z0-9_]*)(!)(?!=)",
          "captures": {
            "1": { "name": "entity.name.function.weft" },
            "2": { "name": "keyword.other.effect.weft" }
          }
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.weft",
          "match": "\\b(Text|Str|Id|Time|Date|Bool|U8|U16|U32|U64|I8|I16|I32|I64|F32|F64|Dec|List|Set|Dict|Html|Cmd|Result)\\b"
        },
        {
          "comment": "`action` as a type, for actions passed to a component: on_select: Id -> action",
          "name": "support.type.builtin.weft",
          "match": "\\baction\\b"
        },
        {
          "comment": "User types and tags: Todo, Filter, All, Some(id), EmptyTitle",
          "name": "entity.name.type.weft",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        { "name": "keyword.other.effect.arrow.weft", "match": "=>" },
        { "name": "keyword.operator.arrow.weft", "match": "->" },
        { "name": "keyword.operator.spread.weft", "match": "\\.\\." },
        { "name": "keyword.operator.comparison.weft", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.assignment.weft", "match": "=" },
        { "name": "keyword.operator.arithmetic.weft", "match": "[+\\-*/%]" },
        { "name": "keyword.operator.try.weft", "match": "\\?" }
      ]
    },

    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.comma.weft", "match": "," },
        { "name": "punctuation.separator.colon.weft", "match": ":" },
        { "name": "punctuation.section.braces.weft", "match": "[{}]" },
        { "name": "punctuation.section.brackets.weft", "match": "[\\[\\]]" },
        { "name": "punctuation.section.parens.weft", "match": "[()]" }
      ]
    },

    "identifiers": {
      "patterns": [
        { "name": "variable.language.wildcard.weft", "match": "\\b_\\b" },
        { "name": "variable.other.readwrite.weft", "match": "\\b[a-z_][A-Za-z0-9_]*\\b" }
      ]
    }
  }
}
