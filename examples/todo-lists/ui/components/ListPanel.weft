/// One list: its name (click to rename), a form to add items, the items, and
/// filters.
component ListPanel(list: TodoList, start: Filter = All) {
  state show     = start
  state draft    = ""
  state renaming = False
  state new_name = ""
  state problem  = None

  open_count = items_in(list.id, All).count_if(|i| not i.done)

  start_renaming = || {
    renaming = True
    new_name = list.name
  }

  rename = || {
    renaming = False
    rename_list(list.id, new_name).await.on_err(|err| problem = err)
  }

  add = || {
    problem = None
    let title = draft
    draft = ""  // clear the input now, not after the server answers
    add_item(list.id, title).await.on_err(|err| problem = err)
  }

  delete = || {
    delete_list(list.id)
    go(Home)
  }

  view = section {
    header {
      if renaming {
        form(on_submit: rename) {
          input(bind: new_name)
          button(on_click: || renaming = False) { "Cancel" }
        }
      } else {
        h2(on_click: start_renaming) { list.name }
      }
    }

    form(on_submit: add) {
      input(bind: draft, placeholder: "Add an item")
    }
    match problem {
      None       -> nothing
      EmptyName  -> p(class: "error") { "A list needs a name" }
      EmptyTitle -> p(class: "error") { "An item needs a title" }
      NoSuchList -> p(class: "error") { "That list was deleted" }
    }

    ul {
      for i in items_in(list.id, show) { ItemRow(item: i) }
    }

    footer {
      span { "${open_count} left" }
      for f in [All, Active, Done] {
        button(on_click: || show = f, pressed: show == f) { f.to_text() }
      }
      button(on_click: || clear_done(list.id)) { "Clear done" }
      button(on_click: delete) { "Delete list" }
    }
  }
}
