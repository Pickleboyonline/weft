// Every write to `lists`.
//
// Commands are written as if the app ran on one machine. Nothing here mentions
// endpoints, validation, retries, locks or duplicate requests: the compiler
// adds those (README, "What to look at").

create_list = Command(|name: Text| -> Result(Id(TodoList), [EmptyName]) {
  let cleaned = name.trim()
  if cleaned.is_empty() { return Err(EmptyName) }
  Ok(lists.insert(TodoList { name: cleaned }))
})

rename_list = Command(|id: Id(TodoList), name: Text| -> Result({}, [EmptyName]) {
  let cleaned = name.trim()
  if cleaned.is_empty() { return Err(EmptyName) }
  Ok(lists.update(id, |l| { ..l, name: cleaned }))
})

/// The list's items go with it: see `delete_with` in data/item.weft.
delete_list = Command(|id: Id(TodoList)| -> {} { lists.delete(id) })
